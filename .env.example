# Supabase (publishable client configuration — safe to ship in the app)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose this in the mobile client.
# Used by the Supabase Edge Function that proxies location search.
GEOAPIFY_API_KEY=

# RevenueCat public SDK keys (safe to ship in the app).
# Leave blank to run without billing; the Plans screen then shows
# "billing unavailable" instead of a purchase button.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional links shown on the Plans screen for store compliance.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
